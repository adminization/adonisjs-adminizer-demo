@layout()
  <div class="blog">
    <div class="blog-intro">
      @if(category)
        <h1>{{ category.name }}</h1>
        @if(category.description)
          <p>{{ category.description }}</p>
        @end
      @elseif(tag)
        <h1>#{{ tag.name }}</h1>
        @if(tag.description)
          <p>{{ tag.description }}</p>
        @end
      @else
        <h1>Blog</h1>
        <p>Articles about technology, travel, food and everyday life.</p>
      @end
    </div>

    <div class="blog-filters">
      @!link({ route: 'home', text: 'All' })
      @each(c in categories)
        @!link({ route: 'categories.show', routeParams: [c.slug], text: c.name })
      @end
      @each(t in tags)
        @!link({ route: 'tags.show', routeParams: [t.slug], text: '#' + t.name })
      @end
    </div>

    @if(articles.length === 0)
      <p class="blog-empty">No articles here yet.</p>
    @else
      <div class="article-list">
        @each(article in articles)
          <a href="{{ urlFor('articles.show', [article.slug]) }}" class="article-card">
            @if(article.coverImage)
              <img src="{{ article.coverImage }}" alt="" class="article-card-cover" />
            @end
            <div class="article-card-body">
              @if(article.category)
                <span class="tag-badge">{{ article.category.name }}</span>
              @end
              <h2>{{ article.title }}</h2>
              <p>{{ article.excerpt }}</p>
              <div class="article-meta">
                <span>{{ article.author.fullName ?? article.author.email }}</span>
                <span>&middot;</span>
                <span>{{ article.publishedAt.toFormat('dd LLL yyyy') }}</span>
              </div>
            </div>
          </a>
        @end
      </div>
    @end
  </div>
@end
